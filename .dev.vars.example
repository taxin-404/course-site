# Copy to .dev.vars for local development (never commit .dev.vars).
# SESSION_SECRET must be a random string of 32+ characters.
SESSION_SECRET=replace-with-a-random-32-char-secret
# The Owner is created from ADMIN_EMAIL on the first request and signs in with Google.
ADMIN_EMAIL=you@gmail.com
# Optional: also allow email + password for the Owner (remove it to make the Owner Google-only).
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: allow direct MP4/WebM playback (default: HLS only)
# ALLOW_MP4=1

# Optional: enables "Continue with Google" (public OAuth Web client ID, not a secret).
# See docs/PLAN-google-login.md
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Optional security tuning (see docs/SECURITY.md)
# MAX_LESSONS_PER_HOUR=20        # distinct lessons a student can open per hour (admins exempt)
# MAX_MBPS=12                    # per-student media speed cap (Mbit/s); higher = fewer buffering risks, faster downloads
# RELAX_FETCH_METADATA=1         # only if an old browser cannot play media (turns off the Sec-Fetch check)
