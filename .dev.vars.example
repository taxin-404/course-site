# Copy to .dev.vars for local development (never commit .dev.vars).
# Both values must be random strings of 32+ characters.
SESSION_SECRET=replace-with-a-random-32-char-secret
SETUP_KEY=replace-with-a-random-32-char-setup-key

# Optional: allow direct MP4/WebM playback (default: HLS only)
# ALLOW_MP4=1
