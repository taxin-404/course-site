# Copy to .dev.vars for local development (never commit .dev.vars).
# SESSION_SECRET must be a random string of 32+ characters.
SESSION_SECRET=replace-with-a-random-32-char-secret
# The first admin is created from these two on the first request.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: allow direct MP4/WebM playback (default: HLS only)
# ALLOW_MP4=1

# Optional: enables "Continue with Google" (public OAuth Web client ID, not a secret).
# See docs/PLAN-google-login.md
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
